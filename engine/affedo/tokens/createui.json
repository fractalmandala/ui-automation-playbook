{
  "name": "createui",
  "version": "1.1.0",
  "modes": [
    "light",
    "dark"
  ],
  "categories": [
    "background",
    "stroke",
    "text",
    "icon",
    "primary",
    "state",
    "status",
    "overlay",
    "shadow",
    "static"
  ],
  "tokens": {
    "background": {
      "--bg": {
        "light": "#ffffff",
        "dark": "#0a0a0b"
      },
      "--bg-weakest": {
        "light": "#fafafa",
        "dark": "#121214"
      },
      "--bg-weaker": {
        "light": "#f4f4f5",
        "dark": "#18181b"
      },
      "--bg-base": {
        "light": "#e4e4e7",
        "dark": "#27272a"
      },
      "--bg-stronger": {
        "light": "#d4d4d8",
        "dark": "#3f3f46"
      },
      "--bg-strongest": {
        "light": "#a1a1aa",
        "dark": "#52525b"
      }
    },
    "stroke": {
      "--stroke-weakest": {
        "light": "#f4f4f5",
        "dark": "#27272a"
      },
      "--stroke-weaker": {
        "light": "#e4e4e7",
        "dark": "#3f3f46"
      },
      "--stroke-base": {
        "light": "#d4d4d8",
        "dark": "#52525b"
      },
      "--stroke-stronger": {
        "light": "#a1a1aa",
        "dark": "#71717a"
      },
      "--stroke-strongest": {
        "light": "#71717a",
        "dark": "#a1a1aa"
      }
    },
    "text": {
      "--text-primary": {
        "light": "#09090b",
        "dark": "#f4f4f5"
      },
      "--text-secondary": {
        "light": "#71717a",
        "dark": "#a1a1aa"
      },
      "--text-tertiary": {
        "light": "#a1a1aa",
        "dark": "#71717a"
      },
      "--text-muted": {
        "light": "#a1a1aa",
        "dark": "#71717a"
      },
      "--text-inverse": {
        "light": "#ffffff",
        "dark": "#09090b"
      }
    },
    "icon": {
      "--icon-primary": {
        "light": "#09090b",
        "dark": "#f4f4f5"
      },
      "--icon-secondary": {
        "light": "#71717a",
        "dark": "#a1a1aa"
      },
      "--icon-tertiary": {
        "light": "#a1a1aa",
        "dark": "#71717a"
      },
      "--icon-disabled": {
        "light": "rgba(9, 9, 11, 0.25)",
        "dark": "rgba(244, 244, 245, 0.25)"
      }
    },
    "primary": {
      "--color-primary": {
        "light": "#2563eb",
        "dark": "#3b82f6"
      },
      "--color-primary-hover": {
        "light": "#1d4ed8",
        "dark": "#60a5fa"
      },
      "--color-primary-active": {
        "light": "#1e40af",
        "dark": "#93c5fd"
      },
      "--color-primary-fg": {
        "light": "#ffffff",
        "dark": "#ffffff"
      },
      "--color-primary-subtle": {
        "light": "#eff6ff",
        "dark": "#172554"
      }
    },
    "state": {
      "--state-hover": {
        "light": "rgba(0, 0, 0, 0.04)",
        "dark": "rgba(255, 255, 255, 0.06)"
      },
      "--state-active": {
        "light": "rgba(0, 0, 0, 0.08)",
        "dark": "rgba(255, 255, 255, 0.1)"
      },
      "--state-selected": {
        "light": "rgba(0, 0, 0, 0.06)",
        "dark": "rgba(255, 255, 255, 0.08)"
      },
      "--state-focus": {
        "light": "#2563eb",
        "dark": "#3b82f6"
      },
      "--state-disabled": {
        "light": "0.45",
        "dark": "0.4"
      }
    },
    "status": {
      "--status-success-bg": {
        "light": "#ecfdf5",
        "dark": "#064e3b"
      },
      "--status-success-fg": {
        "light": "#059669",
        "dark": "#34d399"
      },
      "--status-success-border": {
        "light": "#a7f3d0",
        "dark": "#047857"
      },
      "--status-warning-bg": {
        "light": "#fffbeb",
        "dark": "#78350f"
      },
      "--status-warning-fg": {
        "light": "#d97706",
        "dark": "#fbbf24"
      },
      "--status-warning-border": {
        "light": "#fde68a",
        "dark": "#b45309"
      },
      "--status-danger-bg": {
        "light": "#fef2f2",
        "dark": "#7f1d1d"
      },
      "--status-danger-fg": {
        "light": "#dc2626",
        "dark": "#f87171"
      },
      "--status-danger-border": {
        "light": "#fecaca",
        "dark": "#b91c1c"
      },
      "--status-info-bg": {
        "light": "#eff6ff",
        "dark": "#1e3a8a"
      },
      "--status-info-fg": {
        "light": "#2563eb",
        "dark": "#60a5fa"
      },
      "--status-info-border": {
        "light": "#bfdbfe",
        "dark": "#1d4ed8"
      }
    },
    "overlay": {
      "--overlay-dimmer": {
        "light": "rgba(0, 0, 0, 0.4)",
        "dark": "rgba(0, 0, 0, 0.7)"
      },
      "--blur-xs": {
        "light": "4px",
        "dark": "4px"
      },
      "--blur-sm": {
        "light": "8px",
        "dark": "8px"
      },
      "--blur-md": {
        "light": "12px",
        "dark": "12px"
      },
      "--blur-lg": {
        "light": "16px",
        "dark": "16px"
      },
      "--blur-xl": {
        "light": "24px",
        "dark": "24px"
      }
    },
    "shadow": {
      "--shadow-xs": {
        "light": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
        "dark": "0 1px 2px 0 rgba(0, 0, 0, 0.4)"
      },
      "--shadow-sm": {
        "light": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
        "dark": "0 1px 3px 0 rgba(0, 0, 0, 0.5), 0 1px 2px -1px rgba(0, 0, 0, 0.5)"
      },
      "--shadow-md": {
        "light": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
        "dark": "0 4px 6px -1px rgba(0, 0, 0, 0.6), 0 2px 4px -2px rgba(0, 0, 0, 0.6)"
      },
      "--shadow-lg": {
        "light": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
        "dark": "0 10px 15px -3px rgba(0, 0, 0, 0.7), 0 4px 6px -4px rgba(0, 0, 0, 0.7)"
      },
      "--shadow-xl": {
        "light": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
        "dark": "0 20px 25px -5px rgba(0, 0, 0, 0.8), 0 8px 10px -6px rgba(0, 0, 0, 0.8)"
      }
    },
    "static": {
      "--color-white": {
        "light": "#ffffff",
        "dark": "#ffffff"
      },
      "--color-black": {
        "light": "#000000",
        "dark": "#000000"
      },
      "--color-transparent": {
        "light": "transparent",
        "dark": "transparent"
      }
    }
  },
  "scales": {
    "space": {
      "--space-1": "0.25rem",
      "--space-2": "0.5rem",
      "--space-3": "0.75rem",
      "--space-4": "1rem",
      "--space-5": "1.25rem",
      "--space-6": "1.5rem",
      "--space-8": "2rem",
      "--space-12": "3rem",
      "--space-16": "4rem",
      "--space-32": "8rem"
    },
    "radius": {
      "--radius-xs": "0.125rem",
      "--radius-sm": "0.25rem",
      "--radius-md": "0.5rem",
      "--radius-lg": "0.75rem",
      "--radius-xl": "1rem",
      "--radius-full": "9999px"
    },
    "typography": {
      "--font-sans": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
      "--font-mono": "ui-monospace, Consolas, monospace",
      "--text-xs": "0.75rem",
      "--text-sm": "0.875rem",
      "--text-base": "1rem",
      "--text-lg": "1.125rem",
      "--text-xl": "1.25rem",
      "--text-2xl": "1.5rem"
    },
    "motion": {
      "--duration-instant": "0ms",
      "--duration-fast": "100ms",
      "--duration-normal": "200ms",
      "--duration-slow": "300ms",
      "--ease-in": "cubic-bezier(0.4, 0, 1, 1)",
      "--ease-out": "cubic-bezier(0, 0, 0.2, 1)",
      "--ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--ease-spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    }
  }
}