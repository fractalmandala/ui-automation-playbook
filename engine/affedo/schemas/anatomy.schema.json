{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComponentAnatomy",
  "type": "object",
  "required": [
    "component",
    "parts",
    "props"
  ],
  "properties": {
    "component": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "tag",
          "dataSlot"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "dataSlot": {
            "type": "string"
          }
        }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "default": {},
          "required": {
            "type": "boolean"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "snippets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}