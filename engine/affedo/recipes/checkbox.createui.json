{
  "$schema": "../schemas/recipe.schema.json",
  "component": "Checkbox",
  "branch": "createui",
  "adapter": "createui",
  "parts": {
    "root": "layout.row",
    "control": "control.checkbox-box",
    "icon": "icon.primary",
    "label": "typography.body",
    "hint": "typography.caption"
  },
  "axes": {
    "size": {
      "sm": {
        "boxSize": "1rem",
        "text": "var(--text-xs)"
      },
      "md": {
        "boxSize": "1.25rem",
        "text": "var(--text-sm)"
      },
      "lg": {
        "boxSize": "1.5rem",
        "text": "var(--text-base)"
      }
    }
  }
}