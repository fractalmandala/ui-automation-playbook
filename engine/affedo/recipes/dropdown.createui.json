{
  "$schema": "../schemas/recipe.schema.json",
  "component": "Dropdown",
  "branch": "createui",
  "adapter": "createui",
  "parts": {
    "root": "layout.row",
    "trigger": "control.button-secondary",
    "panel": "surface.floating",
    "item": "control.menu-item",
    "divider": "layout.divider"
  },
  "axes": {
    "size": {
      "sm": {
        "pad": "var(--space-1) var(--space-2)",
        "text": "var(--text-xs)"
      },
      "md": {
        "pad": "var(--space-2) var(--space-3)",
        "text": "var(--text-sm)"
      },
      "lg": {
        "pad": "var(--space-3) var(--space-4)",
        "text": "var(--text-base)"
      }
    }
  }
}