{
	"$comment": "The design system vocabulary, written once. A role has: tokens (base declarations), states (selector suffix -> declarations), when (axis value -> declarations), behavior (lint-only flags, never codegen). Every value is a token name from the active adapter or a literal from vocabulary.json keywords; an array means a space-joined multi-value declaration.",
	"control.ghost": {
		"behavior": {
			"interactive": true
		},
		"$note": "One visual channel per state, on purpose: hover owns background-color, :active owns box-shadow, :focus-visible owns the outline, [data-disabled] owns opacity and cursor, and the data-* states own colour. Two states writing the same property at the same specificity is what a tie IS, and a tie means source order silently decides - so roles only create one where library state genuinely has to beat pointer state.",
		"states": {
			":active": {
				"box-shadow": "shadow-pressed"
			},
			":focus-visible": {
				"outline-color": "focus-ring",
				"outline-offset": "focus-ring-offset",
				"outline-style": "solid",
				"outline-width": "focus-ring-width"
			},
			":active": {
				"box-shadow": "shadow-pressed"
			},
			":hover": {
				"background-color": "bg-hover"
			},
			"[data-disabled]": {
				"cursor": "not-allowed",
				"opacity": "opacity-disabled"
			}
		},
		"tokens": {
			"align-items": "center",
			"background-color": "transparent",
			"border-radius": "radius-s",
			"border-style": "solid",
			"border-width": "0",
			"color": "text-secondary",
			"cursor": "pointer",
			"display": "inline-flex",
			"gap": "space-2xs",
			"justify-content": "space-between",
			"transition": ["color", "duration-fast", "ease-out"],
			"width": "100%"
		},
		"when": {
			"size=lg": {
				"min-height": "control-h-l",
				"padding": ["space-2xs", "space-s"]
			},
			"size=sm": {
				"min-height": "control-h-s",
				"padding": ["space-3xs", "space-2xs"]
			}
		}
	},
